---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import ComparisonTable from "../components/product/ComparisonTable.astro";
import ProductCard from "../components/product/ProductCard.astro";
import TopPickCta from "../components/product/TopPickCta.astro";
import StickyCta from "../components/product/StickyCta.astro";
import ServiceTable from "../components/service/ServiceTable.astro";
import ServiceCard from "../components/service/ServiceCard.astro";
import AffiliateLink from "../components/product/AffiliateLink.astro";
import {
  getLowestOffer,
  getRakutenFallbackOffer,
  getOfferPriceSummary,
  getVisibleOffers,
  getEnabledAffiliateProvidersFromEnv,
  getStaticAffiliateProvidersFromEnv,
  sortOffersByPriceForDisplay,
  getLowestVisibleOffer,
  getRakutenRating,
  type OfferProvider,
} from "../lib/offers";
import {
  formatPriceOrConfirmation,
  formatPriceRange,
  isKnownPrice,
  isVariantPricedProduct,
  resolveDisplayPricePerUnit,
  shouldShowPricePerUnit,
} from "../lib/price";
import { getArticleTargetUnit } from "../lib/capacity";
import { SITE, url } from "../lib/site";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import ArticleToc from "../components/article/ArticleToc.astro";
import SaleBanner from "../components/article/SaleBanner.astro";
import FaqList from "../components/article/FaqList.astro";

const linkProviders = getEnabledAffiliateProvidersFromEnv(import.meta.env);
const priceProviders = getStaticAffiliateProvidersFromEnv(import.meta.env);
const jsonLdProviders = getStaticAffiliateProvidersFromEnv(import.meta.env);

interface Props {
  article: CollectionEntry<"articles">;
  categoryName: string;
  categorySlug: string;
  relatedArticles: CollectionEntry<"articles">[];
  headings?: MarkdownHeading[];
}

const { article, categoryName, categorySlug, relatedArticles, headings } = Astro.props;
const { data } = article;
const isService = data.articleType === "service";
// サービス記事は products[] を持たないため比較記事扱いにしない
const isComparison = data.articleType !== "review" && !isService;
// products はサービス記事に存在せず、レビュー記事でも任意。参照側は常にこの配列を使う
const products = "products" in data && Array.isArray(data.products) ? data.products : [];
const services = "services" in data && Array.isArray(data.services) ? data.services : [];
// pricePerLiter を出した前提（例: 月100L使った場合）。未指定なら併記しない
const serviceBasisNote =
  "pricingBasis" in data && typeof data.pricingBasis === "string" ? data.pricingBasis : undefined;
// 景表法対応の根拠表示（対象範囲・除外費用・出典・比較日）。未指定の項目は出さない
const servicePricingScope =
  "pricingScope" in data && typeof data.pricingScope === "string" ? data.pricingScope : undefined;
const servicePricingExcludes =
  "pricingExcludes" in data && Array.isArray(data.pricingExcludes) ? data.pricingExcludes : undefined;
const servicePricingSource =
  "pricingSource" in data && typeof data.pricingSource === "string" ? data.pricingSource : undefined;
const servicePricingCheckedAt =
  "pricingCheckedAt" in data && data.pricingCheckedAt instanceof Date ? data.pricingCheckedAt : undefined;
const servicePricingTaxIncluded =
  "pricingTaxIncluded" in data && typeof data.pricingTaxIncluded === "boolean"
    ? data.pricingTaxIncluded
    : undefined;

type TocItem = { slug: string; text: string; depth: 2 | 3 };

const markdownTocItems: TocItem[] = (headings ?? [])
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ slug: h.slug, text: h.text, depth: h.depth as 2 | 3 }));

const rawTocItems: TocItem[] = [
  ...(isComparison && products.length > 0
    ? [{ slug: "comparison-table", text: "商品比較表", depth: 2 as const }]
    : []),
  ...(isService && services.length > 0
    ? [
        { slug: "service-table", text: "サービス比較表", depth: 2 as const },
        { slug: "service-cards", text: "各サービスの詳細", depth: 2 as const },
      ]
    : []),
  ...markdownTocItems,
  ...(data.faqs && data.faqs.length > 0
    ? [{ slug: "faq", text: "よくある質問", depth: 2 as const }]
    : []),
  ...(products.length > 0
    ? [{ slug: "product-details", text: isComparison ? "各商品の詳細" : "商品情報", depth: 2 as const }]
    : []),
];

const seenSlugs = new Set<string>();
const seenTexts = new Set<string>();
const tocItems = rawTocItems.filter((item) => {
  const textKey = `${item.depth}:${item.text}`;
  if (seenSlugs.has(item.slug) || seenTexts.has(textKey)) return false;
  seenSlugs.add(item.slug);
  seenTexts.add(textKey);
  return true;
});
const targetUnit = getArticleTargetUnit(article.id);

// 「2026年7月21日」形式。Google が日本語ページの日付を拾いやすい表記にする。
const formatJaDate = (date: Date): string =>
  `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;

// 記事別OGP画像パス（ビルド時に generate-ogp.mjs で生成）
const ogImage = `/og/articles/${article.id}.png`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: {
    "@type": "Person",
    "@id": `${SITE.url}/about/#person`,
    name: "ゆきんこ",
    url: `${SITE.url}/about/`,
  },
  publisher: { "@type": "Organization", name: SITE.nameJa },
  image: data.heroImage ? String(data.heroImage) : `${SITE.url}${SITE.ogImage}`,
  url: `${SITE.url}/articles/${article.id}`,
};

// FAQPage 構造化データ用に answer をプレーンテキスト化する。
// 先頭の A. / **A.** ラベルと太字記法（**）を除去する（移行漏れデータの保険）。
const cleanFaqText = (text: string): string =>
  text
    .replace(/^\*{0,2}A[.．:：]\*{0,2}\s*/, "")
    .replace(/\*\*([^*]+)\*\*/g, "$1");

// FAQ がある記事のみ FAQPage 構造化データを出力する
const faqJsonLd = data.faqs && data.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: cleanFaqText(faq.answer),
    },
  })),
} : null;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: SITE.url },
    { "@type": "ListItem", position: 2, name: categoryName, item: `${SITE.url}/category/${categorySlug}` },
    { "@type": "ListItem", position: 3, name: data.title, item: `${SITE.url}/articles/${article.id}` },
  ],
};

// サービス記事は Product ではなく Service で構造化する。
// 月額は使用量・地域・プランで変動するため price ではなく priceSpecification で
// 「〜円/月の目安」として表現し、断定を避ける。
const serviceJsonLds = services.map((s) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: s.name,
  serviceType: s.waterType === "purifier" ? "浄水型ウォーターサーバー" : "宅配水ウォーターサーバー",
  provider: { "@type": "Organization", name: s.brand },
  areaServed: { "@type": "Country", name: "JP" },
  offers: {
    "@type": "Offer",
    priceCurrency: "JPY",
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: s.monthlyCost,
      priceCurrency: "JPY",
      unitCode: "MON",
    },
    url: `${SITE.url}/articles/${article.id}`,
  },
}));

// Offer / AggregateOffer 共通プロパティ（AggregateOffer は Offer のサブタイプで継承する）
const JSON_LD_OFFER_COMMON = {
  availability: "https://schema.org/InStock",
  shippingDetails: {
    "@type": "OfferShippingDetails",
    shippingDestination: {
      "@type": "DefinedRegion",
      addressCountry: "JP",
    },
  },
  hasMerchantReturnPolicy: {
    "@type": "MerchantReturnPolicy",
    applicableCountry: "JP",
    returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted",
  },
};

// JSON-LD は楽天・Yahoo のみ（Amazon は 24h 鮮度を SSG で保証できないため除外）
const productJsonLds = products
  .filter((p) => p.rating !== undefined)
  .map((p) => {
    let jsonLdOffer: { price: number; url: string; provider: OfferProvider } | null = null;
    const lowest = getLowestOffer(p, { enabledProviders: jsonLdProviders });
    if (lowest) jsonLdOffer = { price: lowest.price, url: lowest.url, provider: lowest.provider };
    if (!jsonLdOffer) {
      const rakuten = getRakutenFallbackOffer(p);
      if (rakuten && typeof rakuten.price === "number" && rakuten.price > 0) {
        jsonLdOffer = { price: rakuten.price, url: rakuten.url, provider: rakuten.provider };
      }
    }
    return { product: p, jsonLdOffer };
  })
  .filter(({ jsonLdOffer }) => jsonLdOffer !== null)
  .map(({ product: p, jsonLdOffer }) => ({
    "@context": "https://schema.org",
    "@type": "Product",
    name: p.name,
    description: `${p.brand}の${p.name}。${p.capacity}。${p.recommendedFor}`,
    brand: { "@type": "Brand", name: p.brand },
    image: p.imageUrl || `${SITE.url}${SITE.ogImage}`,
    // 楽天の価格帯商品は単一 Offer だと「実際に買えない価格」を宣言することになるため
    // AggregateOffer（lowPrice〜highPrice）で出す。採用 offer が楽天のときだけ切り替える
    offers: jsonLdOffer!.provider === "rakuten" && isVariantPricedProduct(p)
      ? {
          "@type": "AggregateOffer",
          priceCurrency: "JPY",
          lowPrice: p.price,
          highPrice: p.priceMax,
          offerCount: 1,
          url: jsonLdOffer!.url,
          ...JSON_LD_OFFER_COMMON,
        }
      : {
          "@type": "Offer",
          priceCurrency: "JPY",
          price: jsonLdOffer!.price,
          url: jsonLdOffer!.url,
          ...JSON_LD_OFFER_COMMON,
        },
    aggregateRating: (() => {
      const r = getRakutenRating(p);
      return r
        ? {
            "@type": "AggregateRating",
            ratingValue: r.rating,
            reviewCount: r.reviewCount,
            bestRating: 5,
            worstRating: 1,
          }
        : undefined;
    })(),
  }));
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={data.publishedAt.toISOString()}
  modifiedTime={(data.updatedAt ?? data.publishedAt).toISOString()}
>
  <Fragment slot="head">
    <JsonLd data={articleJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
    {faqJsonLd && <JsonLd data={faqJsonLd} />}
    {productJsonLds.map((ld) => <JsonLd data={ld} />)}
    {serviceJsonLds.map((ld) => <JsonLd data={ld} />)}
  </Fragment>

  <Container class="py-8 md:py-12">
    <!-- パンくずリスト -->
    <nav aria-label="パンくずリスト" class="mb-6">
      <ol class="flex items-center gap-1.5 text-sm text-[var(--color-text-sub)] flex-wrap">
        <li><a href={url("/")} class="hover:text-[var(--color-primary)] transition-colors">ホーム</a></li>
        <li aria-hidden="true" class="text-[var(--color-border)]">/</li>
        <li><a href={url(`/category/${categorySlug}`)} class="hover:text-[var(--color-primary)] transition-colors">{categoryName}</a></li>
        <li aria-hidden="true" class="text-[var(--color-border)]">/</li>
        <li class="text-[var(--color-text)] font-medium truncate max-w-xs">{data.title}</li>
      </ol>
    </nav>

    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-10">
      <!-- メインコンテンツ -->
      <article>
        <!-- 記事ヘッダー -->
        <header class="mb-8">
          {/*
            PR表記（service のみ）。A8 の全案件で「広告とわかる表示をファーストビュー等の
            見える位置に」が必須要件で、欠けると提携解除・成果キャンセルの対象になる。
            比較記事（楽天等）の表記は従来どおり記事下部のまま＝既存記事の出力は不変。
          */}
          {isService && (
            <p class="mb-3 flex items-center gap-2 text-xs text-[var(--color-text-sub)]">
              <span class="inline-block rounded bg-[var(--color-border)] px-1.5 py-0.5 font-bold text-[var(--color-text)]">
                PR
              </span>
              <span>この記事は広告（アフィリエイトプログラム）を利用しています。</span>
            </p>
          )}
          <div class="flex items-center gap-2 mb-3">
            <a
              href={url(`/category/${categorySlug}`)}
              class="inline-block bg-sky-100 text-sky-700 text-xs font-medium px-2.5 py-0.5 rounded-full hover:bg-sky-200 transition-colors"
            >
              {categoryName}
            </a>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] leading-tight mb-4">
            {data.title}
          </h1>
          <!-- 更新日を主・公開日を従として出す（SERP に公開日が拾われるのを防ぐ） -->
          <div class="flex flex-col gap-0.5">
            <time
              datetime={(data.updatedAt ?? data.publishedAt).toISOString()}
              class="text-sm font-medium text-[var(--color-text)]"
            >
              {formatJaDate(data.updatedAt ?? data.publishedAt)} 更新
            </time>
            {data.updatedAt && (
              <time datetime={data.publishedAt.toISOString()} class="text-xs text-[var(--color-text-sub)]">
                初回公開: {formatJaDate(data.publishedAt)}
              </time>
            )}
          </div>

          <!-- 著者バイライン: JSON-LD の author と対になる人間向け表示（E-E-A-T） -->
          <div class="mt-4 flex items-center gap-3 border-t border-[var(--color-border)] pt-4">
            <img
              src={url("/images/profile-64.webp")}
              alt=""
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
              class="h-8 w-8 shrink-0 rounded-full object-cover"
            />
            <p class="text-xs leading-relaxed text-[var(--color-text-sub)]">
              執筆・更新:
              <a
                href={url("/about")}
                class="font-medium text-[var(--color-text)] underline underline-offset-2 hover:text-[var(--color-primary)]"
              >ゆきんこ</a>（30代・専業主婦／個人運営）
              <span class="block">単位あたり価格で日用品を比較しています。</span>
            </p>
          </div>
        </header>

        <!-- セール期間バナー（PUBLIC_SALE_ACTIVE=true のときのみ表示） -->
        <SaleBanner />

        <!-- ファーストビューCTA: comparison のみ（1位商品） -->
        {isComparison && products.length > 0 && (
          <TopPickCta product={products.find((p) => p.rank === 1) ?? products[0]} targetUnit={targetUnit} />
        )}

        <!-- 目次（モバイル: 比較表の前） -->
        <ArticleToc items={tocItems} class="mt-6 lg:hidden" />

        <!-- 比較表（comparison のみ） -->
        {isComparison && products.length > 0 && (
          <section id="comparison-table" aria-label="商品比較表" class="scroll-mt-24">
            <ComparisonTable products={products} caption={`${data.title} 比較表`} targetUnit={targetUnit} />
          </section>
        )}

        <!-- サービス比較表（service のみ） -->
        {isService && services.length > 0 && (
          <section id="service-table" aria-label="サービス比較表" class="scroll-mt-24">
            <ServiceTable
              services={services}
              caption={`${data.title} 比較表`}
              basisNote={serviceBasisNote}
              scope={servicePricingScope}
              excludes={servicePricingExcludes}
              source={servicePricingSource}
              checkedAt={servicePricingCheckedAt}
              taxIncluded={servicePricingTaxIncluded}
            />
          </section>
        )}

        <!-- サービス個別カード（service のみ）。features / pros / cons / recommendedFor はここで描画する -->
        {isService && services.length > 0 && (
          <section id="service-cards" aria-label="各サービスの詳細" class="scroll-mt-24 mt-10">
            <h2 class="text-xl font-bold text-[var(--color-text)] mb-5">各サービスの詳細</h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {services
                .slice()
                .sort((a, b) => a.rank - b.rank)
                .map((service) => (
                  <ServiceCard service={service} basisNote={serviceBasisNote} />
                ))}
            </div>
          </section>
        )}

        <!-- 記事本文 -->
        <div class="max-w-none mt-8 [&_img]:max-w-full [&_img]:h-auto [&_img]:rounded-lg [&_img]:my-6 [&_figure]:my-6 [&_figcaption]:text-sm [&_figcaption]:text-[var(--color-text-sub)] [&_figcaption]:mt-2 [&_figcaption]:text-center [&_h2]:text-xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-4 [&_h2]:scroll-mt-24 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:scroll-mt-24 [&_p]:mb-4 [&_ul]:mb-4 [&_li]:mb-1 [&_a]:text-[var(--color-primary)] [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-1 [&_a]:transition-colors [&_a:hover]:text-sky-700 [&_a:hover]:decoration-2 [&_table]:w-full [&_table]:text-sm [&_th]:bg-[var(--color-surface)] [&_th]:px-3 [&_th]:py-2 [&_td]:px-3 [&_td]:py-2 [&_td]:border-b [&_td]:border-[var(--color-border)]">
          <slot />
        </div>

        <!-- よくある質問（FAQ）: frontmatter faqs を唯一のソースとしてカード表示 -->
        {data.faqs && data.faqs.length > 0 && (
          <FaqList faqs={data.faqs} />
        )}

        <!-- 記事本文後インライン CTA（comparison: 1位商品 / review: 紹介商品） -->
        {products.length > 0 && (() => {
          const top = products.find((p) => p.rank === 1) ?? products[0];
          const yahooSearchFallback = {
            enabled: import.meta.env.PUBLIC_ENABLE_YAHOO_AFFILIATE === "true",
            sid: import.meta.env.VALUECOMMERCE_SID,
            pid: import.meta.env.VALUECOMMERCE_PID,
          };
          const amazonSearchFallback = {
            enabled: import.meta.env.PUBLIC_ENABLE_AMAZON_AFFILIATE === "true",
            tag: import.meta.env.AMAZON_ASSOCIATE_TAG,
          };
          const visibleOffers = getVisibleOffers(top, { enabledProviders: linkProviders, yahooSearchFallback, amazonSearchFallback });
          const sortedOffers = sortOffersByPriceForDisplay(visibleOffers);
          const lowestVisibleOffer = getLowestVisibleOffer(visibleOffers);
          const isLowestOffer = (offer: typeof visibleOffers[number]) =>
            lowestVisibleOffer
              ? offer.provider === lowestVisibleOffer.provider && offer.url === lowestVisibleOffer.url
              : offer.provider === "rakuten";
          const topSummary = getOfferPriceSummary(top, { enabledProviders: priceProviders });
          const topDisplayPrice = topSummary.lowestPrice ?? (isKnownPrice(top.price) ? top.price : null);
          // コスパ（単価）は最安サイトの価格 × capacity から表示時計算する
          // （楽天の価格帯商品は選択肢で価格が変わるため単価を出さない）
          const topLowestProvider = topSummary.lowestProvider ?? "rakuten";
          const topLowestPricePerUnit = resolveDisplayPricePerUnit(top, topDisplayPrice, targetUnit, topLowestProvider);
          const topPricePerUnitText =
            shouldShowPricePerUnit(topDisplayPrice, topLowestPricePerUnit)
              ? `　${topLowestPricePerUnit}`
              : "";
          const topDisplayPriceLabel =
            (topLowestProvider === "rakuten" ? formatPriceRange(top) : null) ??
            formatPriceOrConfirmation(topDisplayPrice);
          return (
            <div class="mt-8 p-4 md:p-5 bg-sky-50 border border-sky-200 rounded-xl flex flex-col sm:flex-row items-start sm:items-center gap-4">
              <div class="flex-1 min-w-0">
                <p class="text-xs font-semibold text-sky-600 mb-1">{isComparison ? "この記事の結論" : "紹介商品"}</p>
                <p class="font-bold text-[var(--color-text)] text-sm leading-snug line-clamp-2">{top.name}</p>
                <p class="text-sm text-[var(--color-text-sub)] mt-0.5">{topDisplayPriceLabel}{topPricePerUnitText}</p>
                {topSummary.priceDifferenceLabel && (
                  <p class="text-xs text-sky-600 mt-0.5">{topSummary.priceDifferenceLabel}</p>
                )}
              </div>
              <div class="flex flex-col sm:flex-row gap-2">
                {sortedOffers.map((offer) => (
                  <AffiliateLink
                    href={offer.url}
                    provider={offer.provider}
                    label={offer.label}
                    productName={top.name}
                    size="sm"
                    variant={isLowestOffer(offer) ? "primary" : "outline"}
                  />
                ))}
              </div>
            </div>
          );
        })()}

        <!-- 商品詳細セクション -->
        {products.length > 0 && (
          <section id="product-details" aria-label={isComparison ? "商品詳細" : "商品情報"} class="mt-10 scroll-mt-24">
            <h2 class="text-xl font-bold mb-6">{isComparison ? "各商品の詳細" : "商品情報"}</h2>
            <div class="space-y-6">
              {products.map((product) => (
                <ProductCard product={product} id={`product-${product.rank}`} targetUnit={targetUnit} />
              ))}
            </div>
          </section>
        )}

        <!-- アフィリエイト表記 -->
        <div class="mt-10 p-4 bg-amber-50 rounded-xl border border-amber-200 text-sm text-amber-800">
          <p class="font-semibold mb-1">広告・免責事項</p>
          <p>当サイトのリンクには楽天・Yahoo!ショッピング・Amazon等のアフィリエイトを含みます。商品購入により当サイトが報酬を得る場合があります。掲載価格は執筆時点のものです。最新価格は各ショップでご確認ください。</p>
        </div>
      </article>

      <!-- サイドバー（デスクトップ: 目次+関連記事を一体でスクロール追従。目次のみ内側スクロールで縮む） -->
      <aside>
        <div class="lg:sticky lg:top-6 lg:flex lg:flex-col lg:gap-8 lg:max-h-[calc(100vh-3rem)]">
        <!-- 目次（デスクトップ: サイドバー上部） -->
        <ArticleToc items={tocItems} class="hidden lg:flex lg:flex-col lg:min-h-0" />

        <!-- 関連記事 -->
        {relatedArticles.length > 0 && (
          <div class="mt-8 lg:mt-0 lg:shrink-0 bg-[var(--color-surface)] rounded-xl p-5 border border-[var(--color-border)]">
            <h2 class="font-bold text-[var(--color-text)] mb-4">関連記事</h2>
            <ul class="space-y-3">
              {relatedArticles.slice(0, 3).map((a) => (
                <li>
                  <a
                    href={url(`/articles/${a.id}`)}
                    class="block hover:text-[var(--color-primary)] transition-colors"
                  >
                    <span class="text-sm font-medium leading-snug">{a.data.title}</span>
                    <span class="block text-xs text-[var(--color-text-sub)] mt-0.5">
                      {(a.data.updatedAt ?? a.data.publishedAt).toLocaleDateString("ja-JP")} 更新
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        </div>
      </aside>
    </div>
  </Container>

  <!-- モバイル追従CTA（comparison のみ・比較表通過後に表示） -->
  {isComparison && products.length > 0 && (
    <StickyCta product={products.find((p) => p.rank === 1) ?? products[0]} targetUnit={targetUnit} />
  )}
</BaseLayout>

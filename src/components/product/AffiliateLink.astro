---
import type { OfferProvider } from "../../lib/offers";
import {
  AFFILIATE_ICON_CLASS,
  AFFILIATE_ICON_PATH,
  EXTERNAL_ICON_CLASS,
  EXTERNAL_ICON_PATH,
  buildAffiliateLinkAttrs,
} from "../../lib/affiliate-link";

interface Props {
  href: string;
  provider: OfferProvider;
  label?: string;
  variant?: "primary" | "outline";
  size?: "sm" | "md" | "lg";
  productName?: string;
  /** GA4 計測用の設置場所ラベル（例: "sticky_cta"）。未指定は inline 扱い */
  gaPlacement?: string;
}

// 属性の組み立ては src/lib/affiliate-link.ts に集約（本文マーカーのボタンと共有）
const attrs = buildAffiliateLinkAttrs(Astro.props);
---

<a
  href={attrs.href}
  rel={attrs.rel}
  target={attrs.target}
  aria-label={attrs.ariaLabel}
  class={attrs.className}
  data-ga-event={attrs.dataset.gaEvent}
  data-ga-provider={attrs.dataset.gaProvider}
  data-ga-product={attrs.dataset.gaProduct}
  data-ga-placement={attrs.dataset.gaPlacement}
>
  <svg class={AFFILIATE_ICON_CLASS} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d={AFFILIATE_ICON_PATH}/>
  </svg>
  {attrs.label}
  <svg class={EXTERNAL_ICON_CLASS} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={EXTERNAL_ICON_PATH}/>
  </svg>
</a>

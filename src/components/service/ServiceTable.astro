---
import ServiceLink from "./ServiceLink.astro";
import type { Asp } from "./ServiceLink.astro";

interface Service {
  rank: number;
  name: string;
  brand: string;
  monthlyCost: number;
  pricePerLiter: string;
  waterType: "delivery" | "purifier";
  contractMonths: number;
  cancellationFee: number;
  recommendedFor: string;
  affiliateUrl: string;
  asp: Asp;
}

interface Props {
  services: Service[];
  caption?: string;
  /** 円/L を算出した前提（例: 月100L使った場合）。読者が数字の意味を誤解しないよう明示する */
  basisNote?: string;
  /** 比較の対象範囲（例: 工事不要の浄水型4機種。水道直結型・宅配水型は対象外） */
  scope?: string;
  /** 月額に含まない費用 */
  excludes?: string[];
  /** 料金の出典 */
  source?: string;
  /** 料金を確認した日 */
  checkedAt?: Date;
  /** 掲載金額の税区分。総額表示義務があるため、分かっている場合は必ず明示する */
  taxIncluded?: boolean;
}

const {
  services,
  caption = "ウォーターサーバー比較表",
  basisNote,
  scope,
  excludes,
  source,
  checkedAt,
  taxIncluded,
} = Astro.props;

const sorted = [...services].sort((a, b) => a.rank - b.rank);

// 全機種が浄水型なら水代は発生しない。汎用文のまま「水代」を出すと誤認を招く
const hasDeliveryWater = services.some((s) => s.waterType === "delivery");
const costBreakdown = hasDeliveryWater
  ? "サーバーレンタル料＋水代＋電気代"
  : "サーバーレンタル料＋電気代（浄水型のため水の購入代は不要）";

const checkedAtLabel = checkedAt
  ? `${checkedAt.getFullYear()}年${checkedAt.getMonth() + 1}月${checkedAt.getDate()}日`
  : undefined;

const waterTypeLabel = (t: Service["waterType"]) =>
  t === "purifier" ? "浄水型（水道水）" : "宅配水";

const yen = (n: number) => `${n.toLocaleString("ja-JP")}円`;

// 契約期間・解約金は不利益条件のため「なし」も明示する（空欄にしない）
const contractLabel = (months: number) => (months > 0 ? `${months}ヶ月` : "縛りなし");
const cancellationLabel = (fee: number) => (fee > 0 ? yen(fee) : "なし");
---

<div class="my-8">
  <!-- 比較の根拠（対象範囲・前提・除外費用・出典・比較日）。景表法対応のため表の直上に置く -->
  <div class="text-xs text-[var(--color-text-sub)] mb-2 space-y-1">
    {scope && <p>※ 比較の対象範囲：{scope}</p>}
    <p>
      ※ 月額は「{costBreakdown}」の目安です{taxIncluded === true && <>。掲載金額はすべて<strong>税込</strong>です</>}{taxIncluded === false && <>。掲載金額はすべて<strong>税抜</strong>です</>}。使用量・地域・プランにより変動します。
      {basisNote && <><br />※ コスパ（円/L）は、全機種を同じ使用量「{basisNote}」に統一し、その月額を使用量で割って算出しています。</>}
    </p>
    {excludes && excludes.length > 0 && (
      <p>※ 月額に含まない費用：{excludes.join("／")}</p>
    )}
    {(source || checkedAtLabel) && (
      <p>
        <>※ 出典：{source ?? "各社公式サイト"}{checkedAtLabel && <>（{checkedAtLabel}時点で確認）</>}。</>
        料金・仕様は改定されることがあるため、申し込み前に必ず公式サイトの最新情報をご確認ください。
      </p>
    )}
  </div>

  <div class="overflow-x-auto rounded-lg border border-[var(--color-border)]">
    <table class="w-full min-w-[900px] text-sm bg-[var(--color-surface)]">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr class="bg-[var(--color-bg)] text-left">
          <th scope="col" class="px-3 py-3 font-semibold whitespace-nowrap">順位</th>
          <!-- サービス名は最も長い列。幅を確保しないと1文字ずつ折り返して行が縦に伸びる -->
          <th scope="col" class="px-3 py-3 font-semibold w-[260px] min-w-[260px]">サービス</th>
          <th scope="col" class="px-3 py-3 font-semibold whitespace-nowrap">給水方式</th>
          <th scope="col" class="px-3 py-3 font-semibold whitespace-nowrap">コスパ（円/L）</th>
          <th scope="col" class="px-3 py-3 font-semibold whitespace-nowrap">月額目安</th>
          <th scope="col" class="px-3 py-3 font-semibold whitespace-nowrap">契約期間</th>
          <th scope="col" class="px-3 py-3 font-semibold whitespace-nowrap">解約金</th>
          <th scope="col" class="px-3 py-3 font-semibold whitespace-nowrap">詳細</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((service) => (
          <tr class="border-t border-[var(--color-border)] align-middle">
            <td class="px-3 py-3 font-bold text-[var(--color-primary)] whitespace-nowrap">{service.rank}位</td>
            <td class="px-3 py-3 w-[260px] min-w-[260px]">
              <span class="block font-semibold leading-snug">{service.name}</span>
              <span class="block text-xs text-[var(--color-text-sub)] mt-0.5">{service.brand}</span>
            </td>
            <td class="px-3 py-3 whitespace-nowrap">{waterTypeLabel(service.waterType)}</td>
            <td class="px-3 py-3 font-bold whitespace-nowrap">{service.pricePerLiter}</td>
            <td class="px-3 py-3 whitespace-nowrap">{yen(service.monthlyCost)}</td>
            <td class="px-3 py-3 whitespace-nowrap">{contractLabel(service.contractMonths)}</td>
            <td class="px-3 py-3 whitespace-nowrap">{cancellationLabel(service.cancellationFee)}</td>
            <td class="px-3 py-3 min-w-[160px]">
              <ServiceLink
                href={service.affiliateUrl}
                asp={service.asp}
                serviceName={service.name}
                size="sm"
                gaPlacement="service_table"
              />
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="text-xs text-[var(--color-text-sub)] mt-2">
    ※ 契約期間内に解約すると解約金が発生します。金額・条件は必ず公式サイトでご確認ください。
  </p>
  <p class="text-xs text-[var(--color-text-sub)] mt-1">
    ※ 対応エリアが限られるサービスがあります。申し込み前にお住まいの地域が対象か確認してください。
  </p>
</div>

---
import { getCollection, getEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { render } from "astro:content";
import { getRelatedArticles } from "../../lib/relatedArticles";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles
    .filter((a) => !a.data.draft)
    .map((article) => ({
      params: { slug: article.id },
      props: { article },
    }));
}

const { article } = Astro.props;

const categoryEntry = await getEntry(article.data.category);
const categoryName = categoryEntry?.data.name ?? "カテゴリ";
const categorySlug = categoryEntry?.data.slug ?? "";

const allArticles = await getCollection("articles");

// 選定ロジックは src/lib/relatedArticles.ts に集約（3段目 fallback の集中を解消するため
// 全記事を一度に処理する貪欲法になっており、1ページ単位では計算できない）
const relatedArticles = getRelatedArticles(article, allArticles);

const { Content, headings } = await render(article);
---

<ArticleLayout
  article={article}
  categoryName={categoryName}
  categorySlug={categorySlug}
  relatedArticles={relatedArticles}
  headings={headings}
>
  <Content />
</ArticleLayout>

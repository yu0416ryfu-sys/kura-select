# 依存関係
node_modules/
.pnpm-store/

# ビルド出力
dist/
.astro/

# 環境変数
.env

# GSC MCP 認証情報（コミット禁止）
scripts/mcp/gsc-credentials.json
scripts/mcp/gsc-token.json
.env.local
.env.*.local

# エディタ
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ログ
*.log
npm-debug.log*
pnpm-debug.log*

# スクリプトバックアップ
*.bak

# 入れ替え候補レポート（ローカル作業用）
reports/

# ClaudeCode作業メモ
ClaudeCode/

# 実装計画・検討用ドキュメント（作業用、本番不要）
docs/

# Claude Code ローカル設定
.claude/settings.local.json

# Codex ローカル設定
.codex/config.toml

# Claudeの内部作業領域（最も重要な除外）
.claude/worktrees/

# その他のClaude一時・キャッシュ系
.claude/cache/
.claude/tmp/
.claude/logs/
.claude/sessions/
.claude/temp/

# 一時ファイル
_tmp_*

# OGP 自動生成画像（pnpm build / CI で毎回生成されるため管理不要）
public/og-default.png
public/og/

# 運用ドキュメント・SSD同期スクリプト
# （公開リポジトリのため非公開。SSD で持ち運ぶ / 詳細は SETUP.md）
CLAUDE.md
SETUP.md
portable-sync.ps1

# 確認用ファイル
rakuten-check.csv

# RAG（生成物のみ除外。再生成不能な削除履歴は追跡する）
data/rag/

# サービスアカウント鍵（万一リポジトリ内に置かれた場合の保険。本来は ~/.config/kura-select/ に配置）
*service-account*.json
*.iam.gserviceaccount.com.json
kura-select-gsc-*.json

# Claude Code のローカル実行状態
.claude/scheduled_tasks.lock

# 記事用写真の原本（HEIC/JPG。公開用は public/images/articles/ の WebP のみ追跡する）
pictures/

# 一時スキャン用（ローカル作業ディレクトリ）
tmp_scan/

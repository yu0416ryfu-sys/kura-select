{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kura-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "preview"
      ],
      "port": 4321
    },
    {
      "name": "kura-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "kura-preview-4322",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "preview",
        "--port",
        "4322"
      ],
      "port": 4322,
      "autoPort": false
    },
    {
      "name": "kura-dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4330",
        "--bind",
        "127.0.0.1",
        "--directory",
        "reports/dashboard"
      ],
      "port": 4330
    }
  ]
}
